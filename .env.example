# Copy to .env and fill in from the Supabase dashboard (Project settings > API).
# On Vercel these go in Settings > Environment Variables instead.

# Client, and now required for multiplayer as well as accounts: Supabase
# Realtime is the game's transport, so with these blank there are no rooms at
# all. Bundled into the browser build — anon key only, never a secret key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Read by the /api/record-match function, which is the only code of ours that
# runs on a server. The service role key bypasses RLS and must never reach the
# client. Leave these blank and matches simply are not recorded.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Only needed by `pnpm db:push`, never at runtime. The dashboard SQL editor is
# the simplest way to apply supabase/schema.sql and needs none of these.
SUPABASE_DB_PASSWORD=
# Optional: the pooler URI from Project settings > Database > Connection pooling.
# Skips the region search. The direct db.<ref>.supabase.co host is IPv6-only.
SUPABASE_DB_URL=
# Optional: path to the certificate from Project settings > Database > SSL
# configuration. Required for a TLS-verified connection, since Supabase serves
# its own CA.
SUPABASE_DB_CA=
