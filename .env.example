# Copy to .env and fill in from the Supabase dashboard (Project settings > API).
# Leave any of these blank and the game runs guest-only: no sign-in, no stats.

# Client (bundled into the browser build — anon key only, never a secret key).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server. The service role key bypasses RLS and must never reach the client.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Only needed to apply supabase/schema.sql from the CLI, not at runtime.
SUPABASE_DB_PASSWORD=
